{
  "name": "@omdsh-plugins/omdsh-remctrl",
  "description": "Remote control for the DeepSeek Harness: puts its own interface on a public address behind a passcode, over a cloudflared tunnel by default, so the window you reach from a phone is the window you left open",
  "version": "0.2.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-plugins/omdsh-remctrl.git"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "plughub": {
      "displayName": {
        "": "Remote Control",
        "zh": "远程控制"
      },
      "summary": {
        "": "Your dsh window, on a public address, behind a passcode.",
        "zh": "把你的 dsh 界面开放到公网地址，前面挡一道通行码。"
      },
      "category": "system",
      "settings": [
        "omdsh-remctrl"
      ],
      "docs": "https://github.com/omdsh-plugins/omdsh-remctrl#readme",
      "order": 30
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css",
    "scripts/**/*.ts",
    "README.md",
    "README.zh.md",
    "DESIGN.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json && tsdown",
    "typecheck": "tsc --build tsconfig.json --force && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "harness:local": "tsx scripts/harness-source.ts --local",
    "harness:npm": "tsx scripts/harness-source.ts --npm",
    "check:harness-pin": "tsx scripts/harness-source.ts --check",
    "prepare": "tsc --build tsconfig.json && tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.8",
    "@deepseek-ai/schemastery": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "@omdsh-plugins/omdsh-plughub": "^0.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "jsdom": "^26.0.0",
    "lightningcss": "^1.30.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
